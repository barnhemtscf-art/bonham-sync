{
  "entities": {
    "Member": {
      "title": "Member",
      "description": "Barnhem Care & Kids member profile (child, staff, or foundation manager) with daily progress, stars, fines, cover decor, and PII.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["manager", "staff", "kid"] },
        "nickname": { "type": "string", "minLength": 1, "maxLength": 60 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 140 },
        "gender": { "type": "string", "enum": ["M", "F"] },
        "pin": { "type": "string", "minLength": 4, "maxLength": 8, "pattern": "^[0-9]{4,8}$" },
        "emoji": { "type": "string", "maxLength": 16 },
        "ageGroup": { "type": "number" },
        "stars": { "type": "number" },
        "lateFineThb": { "type": "number" },
        "freeDayPenaltyCount": { "type": "number" },
        "phoneBlockedReason": { "type": "string", "maxLength": 300 },
        "cartoonUnlockedToday": { "type": "boolean" },
        "kitchenDutyToday": { "type": "boolean" },
        "personalDriveUrl": { "type": "string", "maxLength": 500 },
        "restrictedDocsUrl": { "type": "string", "maxLength": 500 },
        "mySpace": { "type": "object" },
        "selectedCoverIndex": { "type": "number" },
        "unlockedCovers": { "type": "array" },
        "customCoverImageBase64": { "type": "string", "maxLength": 140000 },
        "ownedShopItemIds": { "type": "array" },
        "equippedOutfitId": { "type": "string", "maxLength": 80 },
        "equippedAccessoryIds": { "type": "array" },
        "collectedLocationItemIds": { "type": "array" },
        "dailyProgress": { "type": "object" },
        "penalties": { "type": "array" },
        "starHistory": { "type": "array" },
        "piggyBank": { "type": "object" },
        "allowedEmails": { "type": "array" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "role",
        "nickname",
        "fullName",
        "gender",
        "pin",
        "stars",
        "lateFineThb",
        "freeDayPenaltyCount",
        "kitchenDutyToday",
        "personalDriveUrl",
        "restrictedDocsUrl",
        "mySpace",
        "selectedCoverIndex",
        "unlockedCovers",
        "ownedShopItemIds",
        "equippedAccessoryIds",
        "collectedLocationItemIds",
        "dailyProgress",
        "penalties",
        "starHistory",
        "allowedEmails",
        "ownerUid",
        "updatedByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "ShopItem": {
      "title": "ShopItem",
      "description": "Barnhem Care & Kids reward shop item (shared snack or cover decoration item).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 140 },
        "nameEn": { "type": "string", "minLength": 1, "maxLength": 140 },
        "priceStars": { "type": "number" },
        "category": { "type": "string", "enum": ["snack", "decor"] },
        "decorSlot": { "type": "string", "enum": ["outfit", "accessory", "location_item"] },
        "locationIndex": { "type": "number" },
        "emoji": { "type": "string", "minLength": 1, "maxLength": 16 },
        "imageBase64": { "type": "string", "maxLength": 140000 },
        "description": { "type": "string", "maxLength": 400 },
        "colorHex": { "type": "string", "maxLength": 20 },
        "allowedEmails": { "type": "array" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "name",
        "nameEn",
        "priceStars",
        "category",
        "emoji",
        "description",
        "allowedEmails",
        "ownerUid",
        "updatedByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "SickReport": {
      "title": "SickReport",
      "description": "Daily child sick report submitted by child or staff, waving daily late fines until resolved.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "kidId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "kidNickname": { "type": "string", "minLength": 1, "maxLength": 60 },
        "symptom": { "type": "string", "minLength": 1, "maxLength": 120 },
        "details": { "type": "string", "maxLength": 500 },
        "reportedAt": { "type": "string", "minLength": 1, "maxLength": 30 },
        "dateStr": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "resolved": { "type": "boolean" },
        "allowedEmails": { "type": "array" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "kidId",
        "kidNickname",
        "symptom",
        "details",
        "reportedAt",
        "dateStr",
        "resolved",
        "allowedEmails",
        "ownerUid",
        "updatedByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "SnackBill": {
      "title": "SnackBill",
      "description": "Star shop redemption receipt for snacks or cover decorations.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "kidId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "kidNickname": { "type": "string", "minLength": 1, "maxLength": 60 },
        "itemId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "itemName": { "type": "string", "minLength": 1, "maxLength": 140 },
        "category": { "type": "string", "enum": ["snack", "decor"] },
        "priceStars": { "type": "number" },
        "createdAtLabel": { "type": "string", "minLength": 1, "maxLength": 30 },
        "dateStr": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "fulfilled": { "type": "boolean" },
        "allowedEmails": { "type": "array" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "kidId",
        "kidNickname",
        "itemId",
        "itemName",
        "category",
        "priceStars",
        "createdAtLabel",
        "dateStr",
        "fulfilled",
        "allowedEmails",
        "ownerUid",
        "updatedByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "FoundationSettings": {
      "title": "FoundationSettings",
      "description": "Creator PINs, Google Sheets Web App URL, and authorized foundation sync emails.",
      "type": "object",
      "properties": {
        "creatorPins": { "type": "array" },
        "googleSheetsUrl": { "type": "string", "maxLength": 500 },
        "allowedEmails": { "type": "array" },
        "holidayDate": { "type": "string", "maxLength": 10 },
        "doorCommands": { "type": "array" },
        "bearStyle": { "type": "object" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "creatorPins",
        "googleSheetsUrl",
        "allowedEmails",
        "ownerUid",
        "updatedByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Additional foundation admin UID granted full RBAC access.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "minLength": 3, "maxLength": 120 },
        "grantedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "grantedByUid", "createdAt"]
    }
  },
  "firestore": {
    "/members/{memberId}": {
      "schema": { "$ref": "#/entities/Member" },
      "description": "Barnhem members collection synced across authorized foundation devices."
    },
    "/shop_items/{itemId}": {
      "schema": { "$ref": "#/entities/ShopItem" },
      "description": "Star shop catalog items (snacks and cover decor)."
    },
    "/sick_reports/{reportId}": {
      "schema": { "$ref": "#/entities/SickReport" },
      "description": "Daily sick reports submitted by kids or staff."
    },
    "/snack_bills/{billId}": {
      "schema": { "$ref": "#/entities/SnackBill" },
      "description": "Snack and reward redemption receipts."
    },
    "/foundation_settings/{settingId}": {
      "schema": { "$ref": "#/entities/FoundationSettings" },
      "description": "Global foundation settings (single document 'main')."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Admin role allowlist documents."
    }
  }
}
